# Copie para .env na raiz. Compose não usa os .env antigos de Backend/Worker/Frontend.
SECRET_KEY=django-local-only-change-this-key-before-deploying-12345
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace-local

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=brecho-products
MINIO_REGION=us-east-1
# Endereço acessível pelo navegador; não use o nome interno "minio" aqui.
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Use caracteres alfanuméricos nestas credenciais, pois compõem a URL AMQP.
RABBITMQ_USER=brecho
RABBITMQ_PASSWORD=brecho
RABBITMQ_IMAGE_QUEUE=image-processing

# Apenas o DynamoDB continua na AWS. Use credenciais com permissão na tabela.
AWS_REGION=us-east-1
DYNAMODB_TABLE=marketplace-audit
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Obrigatório para credenciais temporárias (AWS Academy).
AWS_SESSION_TOKEN=
