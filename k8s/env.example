# Copie para k8s/.env. Valores locais para demonstração.
# Use CHAVE=valor; não use ${VAR:-valor} nem comandos de shell.
SECRET_KEY=django-kubernetes-demo-only-change-this-key-1234567890
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000/api

POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=marketplace-local

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=brecho-products
# O servidor em minIO.yaml também está configurado para us-east-1.
MINIO_REGION=us-east-1
# Endereço interno, usado pelo backend e worker.
MINIO_ENDPOINT_URL=http://minio:9000
# Endereço do navegador; requer port-forward da API MinIO na porta 9000.
MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000

# Credenciais alfanuméricas: os manifestos as interpolam na URL AMQP.
RABBITMQ_USER=brecho
RABBITMQ_PASSWORD=brecho
RABBITMQ_IMAGE_QUEUE=image-processing

# DynamoDB é externo ao cluster. Preencha para demonstrar a auditoria.
AWS_REGION=us-east-1
DYNAMODB_TABLE=marketplace-audit
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Preencha também o token quando usar credenciais temporárias.
AWS_SESSION_TOKEN=
